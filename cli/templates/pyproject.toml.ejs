[build-system]
requires = ["setuptools>=68.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "<%= projectName %>"
version = "1.0.0"
description = "<%= description || 'A Composable Toolkit application' %>"
authors = [{ name = "<%= author || 'Your Name' %>", email = "<%= author ? author.toLowerCase().replace(' ', '.') + '@example.com' : 'you@example.com' %>" }]
readme = "README.md"
requires-python = ">=3.10"
license = { text = "MIT" }

dependencies = [
    "composable-toolkit>=1.0.0",
<% if (framework === 'fastapi') { %>
    "fastapi>=0.104.0",
    "uvicorn[standard]>=0.24.0",
    "pydantic>=2.4.0",
    "pydantic-settings>=2.0.0",
<% } else if (framework === 'django') { %>
    "django>=4.2.0",
    "djangorestframework>=3.14.0",
    "django-cors-headers>=4.3.0",
<% } else if (framework === 'flask') { %>
    "flask>=3.0.0",
    "flask-cors>=4.0.0",
    "flask-restful>=0.3.10",
<% } else if (framework === 'nestjs') { %>
    # NestJS dependencies managed via package.json
<% } %>
<% if (patterns.includes('database')) { %>
    "sqlalchemy>=2.0.0",
    "alembic>=1.12.0",
    "psycopg2-binary>=2.9.0",
    "asyncpg>=0.29.0",
<% } %>
<% if (patterns.includes('cache')) { %>
    "redis>=5.0.0",
    "hiredis>=2.2.0",
<% } %>
<% if (patterns.includes('events') || patterns.includes('queue')) { %>
    "aiokafka>=0.10.0",
    "kafka-python>=2.0.2",
<% } %>
<% if (patterns.includes('auth')) { %>
    "pyjwt>=2.8.0",
    "passlib>=1.7.4",
    "python-multipart>=0.0.6",
<% } %>
<% if (patterns.includes('storage')) { %>
    "boto3>=1.29.0",
    "minio>=7.2.0",
<% } %>
<% if (patterns.includes('search')) { %>
    "elasticsearch>=8.11.0",
<% } %>
<% if (patterns.includes('notifications')) { %>
    "sendgrid>=6.11.0",
    "twilio>=8.10.0",
<% } %>
<% if (patterns.includes('metrics')) { %>
    "prometheus-client>=0.19.0",
<% } %>
<% if (patterns.includes('tracing')) { %>
    "opentelemetry-api>=1.21.0",
    "opentelemetry-sdk>=1.21.0",
    "opentelemetry-instrumentation-fastapi>=0.42b0",
    "opentelemetry-exporter-jaeger>=1.21.0",
<% } %>
]

[project.optional-dependencies]
dev = [
    "pytest>=7.4.0",
    "pytest-asyncio>=0.21.0",
    "pytest-cov>=4.1.0",
    "pytest-benchmark>=4.0.0",
    "ruff>=0.1.0",
    "mypy>=1.7.0",
    "black>=23.11.0",
    "isort>=5.12.0",
    "httpx>=0.25.0",
]

test = [
    "pytest>=7.4.0",
    "pytest-asyncio>=0.21.0",
    "pytest-cov>=4.1.0",
    "pytest-mock>=3.12.0",
    "faker>=20.0.0",
]

docs = [
    "mkdocs>=1.5.0",
    "mkdocs-material>=9.4.0",
    "mkdocstrings[python]>=0.24.0",
]

all = ["<%= projectName %>[dev,test,docs]"]

[tool.setuptools.packages.find]
where = ["<% if (template === 'monorepo') { %>shared/src<% } else { %>src<% } %>"]

[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py", "*_test.py"]
python_classes = ["Test*"]
python_functions = ["test_*"]
addopts = [
    "-v",
    "--strict-markers",
    "--strict-config",
    "--cov-report=term-missing:skip-covered",
]
markers = [
    "slow: marks tests as slow (deselect with '-m \"not slow\"')",
    "integration: marks tests as integration tests",
    "benchmark: marks tests as benchmarks",
]

[tool.coverage.run]
source = ["<% if (template === 'monorepo') { %>shared/src<% } else { %>src<% } %>"]
omit = [
    "*/tests/*",
    "*/test_*.py",
    "*/__pycache__/*",
]

[tool.coverage.report]
exclude_lines = [
    "pragma: no cover",
    "def __repr__",
    "raise AssertionError",
    "raise NotImplementedError",
    "if __name__ == .__main__.:",
    "if TYPE_CHECKING:",
]

[tool.ruff]
line-length = 100
target-version = "py310"

[tool.ruff.lint]
select = [
    "E",   # pycodestyle errors
    "W",   # pycodestyle warnings
    "F",   # pyflakes
    "I",   # isort
    "B",   # flake8-bugbear
    "C4",  # flake8-comprehensions
    "UP",  # pyupgrade
]
ignore = [
    "E501",  # line too long (handled by formatter)
    "B008",  # do not perform function calls in argument defaults
    "C901",  # too complex
]

[tool.mypy]
python_version = "3.10"
warn_return_any = true
warn_unused_configs = true
disallow_untyped_defs = true
disallow_incomplete_defs = true
check_untyped_defs = true
strict_optional = true
warn_redundant_casts = true
warn_unused_ignores = true
warn_no_return = true

[[tool.mypy.overrides]]
module = "tests.*"
disallow_untyped_defs = false

[tool.black]
line-length = 100
target-version = ['py310', 'py311', 'py312']
