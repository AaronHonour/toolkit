"""
<%= patternName %> Lambda Handler
Generated by create-composable-app for <%= projectName %>
"""

import json
import os
from typing import Dict, Any

<% if (patternName === 'cache') { %>
from redis import Redis

redis_client = Redis.from_url(os.environ['REDIS_URL'])
<% } %>

<% if (patternName === 'database') { %>
import psycopg2

def get_db_connection():
    return psycopg2.connect(os.environ['DATABASE_URL'])
<% } %>


def handler(event: Dict[str, Any], context: Any) -> Dict[str, Any]:
    """
    Lambda handler for <%= patternName %>

    Args:
        event: Lambda event object
        context: Lambda context object

    Returns:
        Response with statusCode and body
    """
    try:
        # Parse request
        http_method = event.get('httpMethod', 'GET')
        path = event.get('path', '/')
        body = event.get('body')

        if body:
            body = json.loads(body)

        # Route based on path
        if path == '/health':
            return health_check()
        elif path == '/api/<%= patternName %>':
            if http_method == 'GET':
                return get_<%= patternName %>(event)
            elif http_method == 'POST':
                return create_<%= patternName %>(body)
        else:
            return {
                'statusCode': 404,
                'body': json.dumps({'error': 'Not found'})
            }

    except Exception as e:
        print(f"Error: {str(e)}")
        return {
            'statusCode': 500,
            'body': json.dumps({'error': 'Internal server error'})
        }


def health_check() -> Dict[str, Any]:
    """Health check endpoint"""
    return {
        'statusCode': 200,
        'headers': {'Content-Type': 'application/json'},
        'body': json.dumps({
            'status': 'healthy',
            'function': '<%= patternName %>',
            'project': '<%= projectName %>'
        })
    }


def get_<%= patternName %>(event: Dict[str, Any]) -> Dict[str, Any]:
    """Get <%= patternName %> data"""
<% if (patternName === 'cache') { %>
    # Get from cache
    key = event.get('queryStringParameters', {}).get('key', 'default')
    value = redis_client.get(key)

    return {
        'statusCode': 200,
        'headers': {'Content-Type': 'application/json'},
        'body': json.dumps({
            'key': key,
            'value': value.decode() if value else None
        })
    }
<% } else if (patternName === 'database') { %>
    # Query database
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT COUNT(*) FROM pg_tables")
    count = cursor.fetchone()[0]
    cursor.close()
    conn.close()

    return {
        'statusCode': 200,
        'headers': {'Content-Type': 'application/json'},
        'body': json.dumps({
            'tables': count
        })
    }
<% } else { %>
    # Example response
    return {
        'statusCode': 200,
        'headers': {'Content-Type': 'application/json'},
        'body': json.dumps({
            'message': 'GET <%= patternName %> endpoint',
            'data': []
        })
    }
<% } %>


def create_<%= patternName %>(data: Dict[str, Any]) -> Dict[str, Any]:
    """Create <%= patternName %> item"""
<% if (patternName === 'cache') { %>
    # Set in cache
    key = data.get('key')
    value = data.get('value')
    ttl = data.get('ttl', 300)

    redis_client.setex(key, ttl, value)

    return {
        'statusCode': 201,
        'headers': {'Content-Type': 'application/json'},
        'body': json.dumps({
            'message': 'Created',
            'key': key
        })
    }
<% } else if (patternName === 'database') { %>
    # Insert into database
    conn = get_db_connection()
    cursor = conn.cursor()
    # cursor.execute("INSERT INTO table ...")
    conn.commit()
    cursor.close()
    conn.close()

    return {
        'statusCode': 201,
        'headers': {'Content-Type': 'application/json'},
        'body': json.dumps({
            'message': 'Created'
        })
    }
<% } else { %>
    # Example create
    return {
        'statusCode': 201,
        'headers': {'Content-Type': 'application/json'},
        'body': json.dumps({
            'message': 'Created <%= patternName %>',
            'data': data
        })
    }
<% } %>


