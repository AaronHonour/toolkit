"""
<%= serviceName %> - Flask Service
Generated by create-composable-app
"""

import os
from flask import Flask, jsonify, request
from flask_cors import CORS

<% if (patterns.includes('database')) { %>
from flask_sqlalchemy import SQLAlchemy
<% } %>
<% if (patterns.includes('cache')) { %>
from redis import Redis
<% } %>
<% if (patterns.includes('metrics')) { %>
from prometheus_client import Counter, Histogram, generate_latest
import time
<% } %>

# Create app
app = Flask(__name__)
CORS(app)

# Configuration
app.config['SECRET_KEY'] = os.getenv('SECRET_KEY', 'dev-secret-key')
<% if (patterns.includes('database')) { %>
app.config['SQLALCHEMY_DATABASE_URI'] = os.getenv('DATABASE_URL', 'postgresql://localhost/<%= projectName %>')
app.config['SQLALCHEMY_TRACK_MODIFICATIONS'] = False
<% } %>

<% if (patterns.includes('database')) { %>
# Database
db = SQLAlchemy(app)
<% } %>

<% if (patterns.includes('cache')) { %>
# Redis
redis_client = Redis.from_url(os.getenv('REDIS_URL', 'redis://localhost:6379/0'))
<% } %>

<% if (patterns.includes('metrics')) { %>
# Metrics
request_count = Counter(
    'http_requests_total',
    'Total HTTP requests',
    ['method', 'endpoint', 'status']
)

request_duration = Histogram(
    'http_request_duration_seconds',
    'HTTP request duration',
    ['method', 'endpoint']
)

@app.before_request
def before_request():
    request._start_time = time.time()

@app.after_request
def after_request(response):
    duration = time.time() - request._start_time
    request_duration.labels(
        method=request.method,
        endpoint=request.path
    ).observe(duration)

    request_count.labels(
        method=request.method,
        endpoint=request.path,
        status=response.status_code
    ).inc()

    return response
<% } %>

# Routes
@app.route('/')
def root():
    """Root endpoint"""
    return jsonify({
        'service': '<%= projectName %>',
        'version': '1.0.0',
        'status': 'running'
    })


@app.route('/health')
def health():
    """Health check endpoint"""
<% if (patterns.includes('database')) { %>
    # Check database
    try:
        db.session.execute('SELECT 1')
    except Exception as e:
        return jsonify({'status': 'unhealthy', 'error': str(e)}), 503
<% } %>
<% if (patterns.includes('cache')) { %>
    # Check Redis
    try:
        redis_client.ping()
    except Exception as e:
        return jsonify({'status': 'unhealthy', 'error': str(e)}), 503
<% } %>

    return jsonify({
        'status': 'healthy',
        'service': '<%= projectName %>',
        'version': '1.0.0'
    })

<% if (patterns.includes('metrics')) { %>
@app.route('/metrics')
def metrics():
    """Prometheus metrics endpoint"""
    return generate_latest()
<% } %>

@app.route('/api/items')
def list_items():
    """List items example"""
<% if (patterns.includes('cache')) { %>
    # Try cache first
    cached = redis_client.get('items')
    if cached:
        return jsonify({'items': cached.decode(), 'cached': True})
<% } %>

<% if (patterns.includes('database')) { %>
    # Fetch from database
    # items = Item.query.all()
    items = []
<% } else { %>
    items = []
<% } %>

<% if (patterns.includes('cache')) { %>
    # Cache result
    redis_client.setex('items', 300, str(items))
<% } %>

    return jsonify({'items': items, 'cached': False})


if __name__ == '__main__':
    app.run(
        host='0.0.0.0',
        port=int(os.getenv('PORT', 8000)),
        debug=os.getenv('DEBUG', 'False') == 'True'
    )
