# Database Configuration
DATABASE_URL=postgresql+asyncpg://inventory_user:inventory_pass@localhost:5432/inventory
# For SQLite (development):
# DATABASE_URL=sqlite+aiosqlite:///./inventory.db

# Connection Pool Settings
POOL_SIZE=20
MAX_OVERFLOW=10
POOL_PRE_PING=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# CORS Settings
CORS_ORIGINS=*

# Logging
LOG_LEVEL=info

# Performance
ENABLE_QUERY_CACHE=true
CACHE_SIZE=1000
CACHE_TTL=300
