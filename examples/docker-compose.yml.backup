version: '3.8'

# =============================================================================
# Composable Toolkit - Full Stack Docker Compose
# All 19 backend services + frontend + infrastructure
# =============================================================================

networks:
  unistax-network:
    driver: bridge

volumes:
  postgres-data:
  redis-data:
  kafka-data:
  zookeeper-data:
  timescale-data:
  prometheus-data:
  grafana-data:

services:
  # ===========================================================================
  # Infrastructure Services
  # ===========================================================================

  # PostgreSQL Database
  postgres:
    image: postgres:15-alpine
    container_name: unistax-postgres
    environment:
      POSTGRES_USER: toolkit
      POSTGRES_PASSWORD: unistax_dev
      POSTGRES_DB: toolkit
    ports:
      - "5432:5432"
    volumes:
      - postgres-data:/var/lib/postgresql/data
    networks:
      - unistax-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U toolkit"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Redis Cache
  redis:
    image: redis:7-alpine
    container_name: unistax-redis
    command: redis-server --appendonly yes
    ports:
      - "6379:6379"
    volumes:
      - redis-data:/data
    networks:
      - unistax-network
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5

  # Kafka
  zookeeper:
    image: confluentinc/cp-zookeeper:7.5.0
    container_name: unistax-zookeeper
    environment:
      ZOOKEEPER_CLIENT_PORT: 2181
      ZOOKEEPER_TICK_TIME: 2000
    ports:
      - "2181:2181"
    volumes:
      - zookeeper-data:/var/lib/zookeeper/data
    networks:
      - unistax-network

  kafka:
    image: confluentinc/cp-kafka:7.5.0
    container_name: unistax-kafka
    depends_on:
      - zookeeper
    ports:
      - "9092:9092"
    environment:
      KAFKA_BROKER_ID: 1
      KAFKA_ZOOKEEPER_CONNECT: zookeeper:2181
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:9092
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "true"
    volumes:
      - kafka-data:/var/lib/kafka/data
    networks:
      - unistax-network
    healthcheck:
      test: ["CMD", "kafka-broker-api-versions", "--bootstrap-server", "localhost:9092"]
      interval: 30s
      timeout: 10s
      retries: 5

  # TimescaleDB (for time-series data)
  timescale:
    image: timescale/timescaledb:latest-pg15
    container_name: unistax-timescale
    environment:
      POSTGRES_USER: toolkit
      POSTGRES_PASSWORD: unistax_dev
      POSTGRES_DB: toolkit
    ports:
      - "5433:5432"
    volumes:
      - timescale-data:/var/lib/postgresql/data
    networks:
      - unistax-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U toolkit"]
      interval: 10s
      timeout: 5s
      retries: 5

  # ===========================================================================
  # Backend Services (01-19)
  # ===========================================================================

  # App 01: E-Commerce Inventory
  app01-inventory:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app01
    working_dir: /app/backends/01_high_performance_rest_api
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8001 --reload
    ports:
      - "8001:8001"
    environment:
      DATABASE_URL: postgresql://unistax:unistax_dev@postgres:5432/toolkit
      REDIS_URL: redis://redis:6379/0
      PYTHONPATH: /app:/a./backends/01_high_performance_rest_api
    depends_on:
      - postgres
      - redis
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8001/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  # App 02: Real-Time Analytics
  app02-analytics:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app02
    working_dir: /app/backends/02_realtime_analytics_dashboard
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8002 --reload
    ports:
      - "8002:8002"
    environment:
      KAFKA_BROKERS: kafka:9092
      PYTHONPATH: /app:/a./backends/02_realtime_analytics_dashboard
    depends_on:
      - kafka
      - redis
      - timescale
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network

  # App 03: File Processing
  app03-file-processor:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app03
    working_dir: /app/backends/03_file_processing_service
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8003 --reload
    ports:
      - "8003:8003"
    environment:
      REDIS_URL: redis://redis:6379/2
      PYTHONPATH: /app:/a./backends/03_file_processing_service
    depends_on:
      - redis
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
      - ./uploads:/app/uploads
    networks:
      - unistax-network

  # App 04: API Gateway
  app04-gateway:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app04
    working_dir: /app/backends/04_microservices_gateway
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8004 --reload
    ports:
      - "8004:8004"
    environment:
      REDIS_URL: redis://redis:6379/3
      PYTHONPATH: /app:/a./backends/04_microservices_gateway
    depends_on:
      - redis
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network

  # App 05: Data Export
  app05-export:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app05
    working_dir: /app/backends/05_data_export_service
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8005 --reload
    ports:
      - "8005:8005"
    environment:
      DATABASE_URL: postgresql://unistax:unistax_dev@postgres:5432/toolkit
      PYTHONPATH: /app:/a./backends/05_data_export_service
    depends_on:
      - postgres
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network

  # App 06: Kappa Architecture Monitor
  app06-kappa:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app06
    working_dir: /app/backends/06_kappa_architecture
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8006 --reload
    ports:
      - "8006:8006"
    environment:
      KAFKA_BROKERS: kafka:9092
      PYTHONPATH: /app:/a./backends/06_kappa_architecture
    depends_on:
      - kafka
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network

  # App 07: Event Sourcing
  app07-eventsourcing:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app07
    working_dir: /app/backends/07_event_sourcing
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8007 --reload
    ports:
      - "8007:8007"
    environment:
      DATABASE_URL: postgresql://unistax:unistax_dev@postgres:5432/toolkit
      PYTHONPATH: /app:/a./backends/07_event_sourcing
    depends_on:
      - postgres
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network

  # App 08: TimeSeries Database
  app08-timeseries:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app08
    working_dir: /app/backends/08_timeseries_db
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8008 --reload
    ports:
      - "8008:8008"
    environment:
      TIMESCALE_URL: postgresql://unistax:unistax_dev@timescale:5432/timeseries
      PYTHONPATH: /app:/a./backends/08_timeseries_db
    depends_on:
      - timescale
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network

  # App 09: Distributed Cache
  app09-cache:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app09
    working_dir: /app/backends/09_distributed_cache
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8009 --reload
    ports:
      - "8009:8009"
    environment:
      REDIS_URL: redis://redis:6379/4
      PYTHONPATH: /app:/a./backends/09_distributed_cache
    depends_on:
      - redis
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network

  # App 10: Message Queue Manager
  app10-queue:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app10
    working_dir: /app/backends/10_message_queue
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8010 --reload
    ports:
      - "8010:8010"
    environment:
      KAFKA_BROKERS: kafka:9092
      PYTHONPATH: /app:/a./backends/10_message_queue
    depends_on:
      - kafka
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network

  # App 11: Rate Limiter Dashboard
  app11-ratelimiter:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app11
    working_dir: /app/backends/11_rate_limiter
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8011 --reload
    ports:
      - "8011:8011"
    environment:
      REDIS_URL: redis://redis:6379/5
      PYTHONPATH: /app:/a./backends/11_rate_limiter
    depends_on:
      - redis
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network

  # App 12: Lambda Architecture
  app12-lambda:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app12
    working_dir: /app/backends/12_lambda_architecture
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8012 --reload
    ports:
      - "8012:8012"
    environment:
      KAFKA_BROKERS: kafka:9092
      PYTHONPATH: /app:/a./backends/12_lambda_architecture
    depends_on:
      - kafka
      - postgres
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network

  # App 13: CDC Monitor
  app13-cdc:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app13
    working_dir: /app/backends/13_cdc_pipeline
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8013 --reload
    ports:
      - "8013:8013"
    environment:
      DATABASE_URL: postgresql://unistax:unistax_dev@postgres:5432/toolkit
      PYTHONPATH: /app:/a./backends/13_cdc_pipeline
    depends_on:
      - postgres
      - kafka
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network

  # App 14: Recommendation Engine
  app14-recommendations:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app14
    working_dir: /app/backends/14_recommendation_engine
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8014 --reload
    ports:
      - "8014:8014"
    environment:
      DATABASE_URL: postgresql://unistax:unistax_dev@postgres:5432/toolkit
      PYTHONPATH: /app:/a./backends/14_recommendation_engine
    depends_on:
      - postgres
      - redis
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network

  # App 15: Search Engine
  app15-search:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app15
    working_dir: /app/backends/15_fulltext_search
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8015 --reload
    ports:
      - "8015:8015"
    environment:
      REDIS_URL: redis://redis:6379/7
      PYTHONPATH: /app:/a./backends/15_fulltext_search
    depends_on:
      - redis
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network

  # App 16: Feature Store
  app16-featurestore:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app16
    working_dir: /app/backends/16_feature_store
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8016 --reload
    ports:
      - "8016:8016"
    environment:
      DATABASE_URL: postgresql://unistax:unistax_dev@postgres:5432/toolkit
      PYTHONPATH: /app:/a./backends/16_feature_store
    depends_on:
      - postgres
      - redis
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network

  # App 17: OLAP Dashboard
  app17-olap:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app17
    working_dir: /app/backends/17_realtime_olap
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8017 --reload
    ports:
      - "8017:8017"
    environment:
      DATABASE_URL: postgresql://unistax:unistax_dev@postgres:5432/toolkit
      PYTHONPATH: /app:/a./backends/17_realtime_olap
    depends_on:
      - postgres
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network

  # App 18: Distributed Tracing
  app18-tracing:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app18
    working_dir: /app/backends/18_distributed_tracing
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8018 --reload
    ports:
      - "8018:8018"
    environment:
      REDIS_URL: redis://redis:6379/9
      PYTHONPATH: /app:/a./backends/18_distributed_tracing
    depends_on:
      - redis
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network

  # App 19: Probabilistic Structures
  app19-probabilistic:
    build:
      context: ../python
      dockerfile: Dockerfile
      target: development
    container_name: unistax-app19
    working_dir: /app/backends/19_probabilistic_structures
    command: python -m uvicorn src.main:app --host 0.0.0.0 --port 8019 --reload
    ports:
      - "8019:8019"
    environment:
      REDIS_URL: redis://redis:6379/10
      PYTHONPATH: /app:/a./backends/19_probabilistic_structures
    depends_on:
      - redis
    volumes:
      - ./src:/app/src
      - ./examples:/app/examples
    networks:
      - unistax-network

  # ===========================================================================
  # Frontend Services
  # ===========================================================================

  # Frontend - Development
  frontend:
    build:
      context:../frontend
      dockerfile: Dockerfile
      target: development
    container_name: unistax-frontend
    ports:
      - "3000-3019:3000-3019"
    environment:
      VITE_API_BASE_URL: http://localhost:8001
    volumes:
      -../frontend:/app
      - /app/node_modules
    networks:
      - unistax-network
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:3000"]
      interval: 30s
      timeout: 10s
      retries: 3

  # ===========================================================================
  # Documentation Site
  # ===========================================================================

  docs:
    build:
      context: ./docs
      dockerfile: Dockerfile
      target: development
    container_name: unistax-docs
    ports:
      - "5173:5173"
    volumes:
      - ./docs:/app
      - /app/node_modules
    networks:
      - unistax-network
    command: npm run docs:dev -- --host 0.0.0.0

  # ===========================================================================
  # Observability Stack
  # ===========================================================================

  # Prometheus - Metrics collection
  prometheus:
    image: prom/prometheus:latest
    container_name: unistax-prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--web.console.libraries=/usr/share/prometheus/console_libraries'
      - '--web.console.templates=/usr/share/prometheus/consoles'
      - '--web.enable-lifecycle'
    ports:
      - "9090:9090"
    volumes:
      - ./observability/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml
      - ./observability/prometheus/rules:/etc/prometheus/rules
      - prometheus-data:/prometheus
    networks:
      - unistax-network
    restart: unless-stopped

  # Grafana - Metrics visualization
  grafana:
    image: grafana/grafana:latest
    container_name: unistax-grafana
    ports:
      - "9999:3000"
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=admin
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_INSTALL_PLUGINS=grafana-piechart-panel
    volumes:
      - ./observability/grafana/dashboards:/etc/grafana/provisioning/dashboards
      - ./observability/grafana/datasources:/etc/grafana/provisioning/datasources
      - grafana-data:/var/lib/grafana
    networks:
      - unistax-network
    depends_on:
      - prometheus
    restart: unless-stopped

  # Jaeger - Distributed tracing
  jaeger:
    image: jaegertracing/all-in-one:latest
    container_name: unistax-jaeger
    ports:
      - "5775:5775/udp"
      - "6831:6831/udp"
      - "6832:6832/udp"
      - "5778:5778"
      - "16686:16686"  # UI
      - "14268:14268"
      - "14250:14250"
      - "9411:9411"
    environment:
      - COLLECTOR_ZIPKIN_HOST_PORT=:9411
    networks:
      - unistax-network
    restart: unless-stopped

  # Loki - Log aggregation
  loki:
    image: grafana/loki:latest
    container_name: unistax-loki
    ports:
      - "3100:3100"
    command: -config.file=/etc/loki/local-config.yaml
    networks:
      - unistax-network
    restart: unless-stopped

  # Promtail - Log shipper
  promtail:
    image: grafana/promtail:latest
    container_name: unistax-promtail
    volumes:
      - /var/log:/var/log
      - ./observability/promtail/config.yml:/etc/promtail/config.yml
    command: -config.file=/etc/promtail/config.yml
    networks:
      - unistax-network
    depends_on:
      - loki
    restart: unless-stopped
